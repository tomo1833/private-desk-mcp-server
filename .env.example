# Private Desk MCP Server - Environment Variables

# データベース接続設定
# Private Desk のデータベースファイルのパス
# ローカル開発: /home/user/projects/private-desk/data/database.sqlite
# Raspberry Pi 環境（NFS経由）: /mnt/private-desk/data/database.sqlite
# Samba共有: /mnt/smb/private-desk/data/database.sqlite
PRIVATE_DESK_DB_PATH=../private-desk/data/database.sqlite

